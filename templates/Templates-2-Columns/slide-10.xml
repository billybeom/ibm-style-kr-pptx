:nvPr><p:ph type="body" sz="quarter" idx="12"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="en-GB" dirty="0"><a:latin typeface="IBM Plex Sans Medm" panose="020B0503050203000203" pitchFamily="34" charset="0"/></a:rPr><a:t>Chapter 2 requirements</a:t></a:r></a:p><a:p><a:r><a:rPr lang="en-GB" dirty="0"><a:latin typeface="+mn-lt"/></a:rPr><a:t>Mission-critical middleware, databases and existing apps make up ~60% of the opportunity; bulk of growth will be funded through digital acceleration (80%)</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" dirty="0"><a:latin typeface="+mn-lt"/></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-GB" dirty="0"><a:latin typeface="+mn-lt"/></a:rPr><a:t>Containerization to increase substantially: ~45%–50% rewrites and ~65% net new.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="19" name="Text Placeholder 18"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{35B979FB-B77F-43BA-CBC1-99745DB44217}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="body" sz="quarter" idx="13"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="en-GB" dirty="0"><a:latin typeface="IBM Plex Sans Medm" panose="020B0503050203000203" pitchFamily="34" charset="0"/></a:rPr><a:t>Our actions</a:t></a:r></a:p><a:p><a:r><a:rPr lang="en-GB" dirty="0"><a:latin typeface="+mn-lt"/></a:rPr><a:t>In 2021, we introduced hybrid cloud journeys to capture Chapter 2 workloads on the Red Hat® OpenShift® platform: middleware, databases and Microsoft applications.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" dirty="0"><a:latin typeface="+mn-lt"/></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-GB" dirty="0"><a:latin typeface="+mn-lt"/></a:rPr><a:t>Now we’re expanding hybrid cloud journeys to support migrations and app modernization, and to build on IBM Cloud, Microsoft Azure, Amazon Web Services (AWS) and Google Cloud Platform (GCP).</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" dirty="0"><a:latin typeface="+mn-lt"/></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-GB" dirty="0"><a:latin typeface="+mn-lt"/></a:rPr><a:t>We are also strengthening capabilities to accelerate existing mainframe modernization.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" dirty="0"><a:latin typeface="+mn-lt"/></a:endParaRPr></a:p><a:p><a:endParaRPr lang="en-RO"><a:latin typeface="+mn-lt"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="35" name="Footer Placeholder 3"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{0E228955-E819-5A64-5C86-AFB181B64141}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="ftr" sz="quarter" idx="16"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="568324" y="12804235"/><a:ext cx="4956176" cy="381000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr vert="horz" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="b"/><a:lstStyle><a:defPPr><a:defRPr lang="en-US"/></a:defPPr><a:lvl1pPr marL="0" algn="l" defTabSz="1829379" rtl="0" eaLnBrk="1" latinLnBrk="0" hangingPunct="1"><a:defRPr sz="1600" b="0" i="0" kern="1200"><a:solidFill><a:schemeClr val="tx1"/></a:solidFill><a:latin typeface="IBM Plex Sans" panose="020B0503050203000203" pitchFamily="34" charset="0"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:defRPr></a:lvl1pPr><a:lvl2pPr marL="914688" algn="l" defTabSz="1829379" rtl="0" eaLnBrk="1" latinLnBrk="0" hangingPunct="1"><a:defRPr sz="3600" kern="1200"><a:solidFill><a:schemeClr val="tx1"/></a:solidFill><a:latin typeface="+mn-lt"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:defRPr></a:lvl2pPr><a:lvl3pPr marL="1829379" algn="l" defTabSz="1829379" rtl="0" eaLnBrk="1" latinLnBrk="0" hangingPun